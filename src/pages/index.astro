---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { contact } from '../data/contact';
---

<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-star" aria-hidden="true">✳</span> Nápady pro každodenní život</p>
      <h1 id="hero-title">We Are<br /><span>Your Friends</span><span class="title-period" aria-hidden="true">.</span></h1>
      <p class="hero-lead">Tvoříme užitečné projekty<br class="desktop-break" /> pro každodenní život.</p>
      <p class="hero-description">Od jídla a pohybu po objevování obsahu a hledání nejbližšího WC. Zkoušíme nápady, které lidem usnadňují den.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projekty">Prozkoumat projekty <span aria-hidden="true">↘</span></a>
        {contact.email && <a class="text-link" href="#kontakt">Ozvat se <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
    <div class="hero-brand" aria-hidden="true">
      <img src="/weareyourfriends-logo-vector.svg" alt="" width="996" height="878" />
      <span class="hero-caption">Trochu zvědavosti.<br />Spousta možností.</span>
    </div>
  </section>

  <section class="projects-section container section" id="projekty" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Co tvoříme</p>
        <h2 id="projects-title">Naše projekty<span class="title-period" aria-hidden="true">.</span></h2>
      </div>
      <p class="section-intro">Různé nápady. Společná chuť<br /> dělat užitečné věci.</p>
    </div>
    <div class="projects-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="about-section container section" id="o-nas" aria-labelledby="about-title">
    <div class="about-intro">
      <div>
        <p class="eyebrow">02 / O nás</p>
        <h2 id="about-title">Malé nápady.<br /><span>Užitečné věci.</span></h2>
      </div>
      <p>We Are Your Friends propojuje projekty z různých oblastí každodenního života. Zajímá nás, co může fungovat lépe, a baví nás hledat jednoduchá řešení. Zkoušíme, učíme se a rozvíjíme to, co lidem pomáhá.</p>
    </div>
    <div class="values-grid">
      <div class="value">
        <span class="value-symbol" aria-hidden="true">↗</span>
        <h3>Užitečnost</h3>
        <p>Začínáme u skutečné potřeby.</p>
      </div>
      <div class="value">
        <span class="value-symbol" aria-hidden="true">✳</span>
        <h3>Zvídavost</h3>
        <p>Dáváme prostor novým nápadům a experimentům.</p>
      </div>
      <div class="value">
        <span class="value-symbol" aria-hidden="true">→</span>
        <h3>Jednoduchost</h3>
        <p>Hledáme nejkratší cestu k něčemu, co funguje.</p>
      </div>
    </div>
  </section>

  {contact.email && <section class="contact-section container section" id="kontakt" aria-labelledby="contact-title">
    <div class="contact-panel">
      <p class="eyebrow">03 / Pojďme si napsat</p>
      <h2 id="contact-title">Máš nápad?<br /><span>Ozvi se.</span></h2>
      <p>Zajímá tě některý z projektů nebo vidíš prostor něco vymyslet společně? Napiš nám.</p>
      <a class="contact-email" href={`mailto:${contact.email}`}>{contact.email} <span aria-hidden="true">↗</span></a>
      <span class="contact-star" aria-hidden="true">✳</span>
    </div>
  </section>}
</Layout>
