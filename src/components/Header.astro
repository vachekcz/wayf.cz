---
import { contact } from '../data/contact';
---

<nav class="aliens-nav" aria-label="Hlavní navigace">
  <div class="aliens-nav-inner">
    <a class="aliens-nav-logo" href="/" aria-label="WAYF — úvodní stránka">
      <img
        class="aliens-nav-logo-image"
        src="/weareyourfriends-logo-vector.svg"
        alt="We Are Your Friends"
        width="96"
        height="85"
      />
    </a>
    <div class="nav-links">
      <a href="#projekty">Projekty</a>
      <a href="#o-nas">O nás</a>
      {contact.email && <a href="#kontakt">Kontakt <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</nav>

<style>
  .aliens-nav-logo {
    display: block;
    flex-shrink: 0;
  }

  .aliens-nav-logo-image {
    display: block;
    width: 6rem;
    height: auto;
    /* Display the original black vector in white on the dark background. */
    filter: brightness(0) invert(1);
  }
</style>
