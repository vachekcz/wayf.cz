{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wayf-cz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "wayf.cz",
      "custom_domain": true,
      "zone_name": "wayf.cz"
    },
    {
      "pattern": "www.wayf.cz",
      "custom_domain": true,
      "zone_name": "wayf.cz"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
