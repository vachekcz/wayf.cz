{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wayf-cz",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "wayf.cz",
      "custom_domain": true,
      "zone_name": "wayf.cz"
    }
  ],
  "assets": {
    "directory": "./dist"
  }
}
